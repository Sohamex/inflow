datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id    String @id @default(cuid())
  name  String
  chats Chat[]
}

model Chat {
  id        String  @id @default(cuid())
  name      String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  turns     Turn[]
}

model Turn {
  id         String  @id @default(cuid())
  chatId     String
  chat       Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userQuery  String
  aiResponse String
  parentId   String?
}
